{
	"name": "@anti049/lunar-ui",
	"version": "0.1.0",
	"description": "Framework-agnostic Tailwind CSS v4 component styles, design tokens, and themes.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Anti049/lunar-ui-old.git",
		"directory": "packages/core"
	},
	"type": "module",
	"scripts": {
		"build": "echo 'no build step - ships raw CSS'",
		"check": "publint"
	},
	"sideEffects": [
		"**/*.css"
	],
	"style": "./src/index.css",
	"files": [
		"src"
	],
	"exports": {
		".": "./src/index.css",
		"./index.css": "./src/index.css",
		"./fonts.css": "./src/core/fonts.css",
		"./themes.css": "./src/themes/_index.css",
		"./themes/*.css": "./src/themes/*.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"dependencies": {
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19"
	},
	"peerDependencies": {
		"@fontsource-variable/fira-code": "^5.2.7",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/plus-jakarta-sans": "^5.2.8",
		"tailwindcss": "^4.3.0"
	},
	"peerDependenciesMeta": {
		"@fontsource-variable/fira-code": {
			"optional": true
		},
		"@fontsource-variable/inter": {
			"optional": true
		},
		"@fontsource-variable/plus-jakarta-sans": {
			"optional": true
		}
	},
	"devDependencies": {
		"publint": "^0.3.21"
	},
	"keywords": [
		"tailwindcss",
		"tailwind-plugin",
		"css",
		"design-system",
		"ui"
	]
}
