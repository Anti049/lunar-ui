{
	"name": "@anti049/lunar-ui-plugin",
	"version": "0.7.0",
	"private": true,
	"description": "Proof-of-concept: lunar-ui component CSS compiled to a Tailwind JS plugin, DaisyUI-style. Badge and button only.",
	"type": "module",
	"scripts": {
		"build": "bun build/build.ts && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "bun test/e2e.test.ts",
		"check": "bun run build && bun run typecheck && bun run test",
		"package": "bun run build && mkdir -p ../../build && npm pack --pack-destination ../../build"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./theme": {
			"types": "./dist/theme.d.ts",
			"default": "./dist/theme.js"
		},
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"@anti049/lunar-ui": "workspace:*",
		"@tailwindcss/cli": "^4.3.3",
		"postcss": "^8.5.6",
		"postcss-js": "^4.0.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"@types/node": "^24",
		"@types/postcss-js": "^4.0.4"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@material/material-color-utilities": "^0.4.0"
	}
}
